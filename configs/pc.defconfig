# ============================================================
#  PC（Ubuntu 桌面）验证配置 —— 用 SDL2 弹窗看真实 UI 画面
#  与开发板 configs/get_started.defconfig 的差异【仅在后端三行】，
#  其余（标准库/OS/颜色深度/日志/字体）完全相同。
#  构建：cmake -B build_pc -DLV_PORT_DEFCONFIG=configs/pc.defconfig ...
# ============================================================

# --- 标准库与 OS（PC 与板子相同）---
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_OS_PTHREAD=y

# --- 显示参数（PC 与板子相同；屏为 RGB565）---
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DEF_REFR_PERIOD=16

# --- 后端：PC 用 SDL2 窗口；开发板用 FBDEV+EVDEV（下面注释行即板子的，反过来在板子文件里被注释）---
CONFIG_LV_USE_SDL=y
# CONFIG_LV_USE_LINUX_FBDEV is not set      # ← 开发板这行改成 =y，本行注释掉
# CONFIG_LV_USE_LINUX_DRM is not set
# CONFIG_LV_USE_EVDEV is not set            # ← 开发板这行改成 =y

# --- 日志（串口/终端可见 [ACTUATOR] 等输出）---
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y

# --- 默认字体（LVGL 必选一个内置字体作兜底；业务中文字体为独立嵌入源文件）---
CONFIG_LV_FONT_MONTSERRAT_14=y

# --- 键盘（lv_keyboard）：按键文本是 ASCII + LVGL 符号(⌫ ↩ ⏎)，
#     这些码位只有 Montserrat 有（Noto CJK 会变方块）→ 键盘整块走 Montserrat，
#     字号按 ui_scale 放大。app_montserrat_scaled() 的档位表依赖下面这些字号，
#     关掉某一档不会编译失败（有 #if 守卫），但会回落到更小的字号。
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_22=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_MONTSERRAT_44=y
CONFIG_LV_FONT_MONTSERRAT_48=y

# --- FreeType：PC 从系统 Noto CJK 动态渲染中文，彻底避免嵌入位图缺字（DESIGN.md §4）---
CONFIG_LV_USE_FREETYPE=y
# 与板端 board.defconfig 对齐（板端已是 1024）：CJK 界面字形多，缓存太小会反复光栅化。
# PC 不缺算力，这里设同值是为了**验证保真**——让 PC 的字形缓存行为与板端一致，
# 避免「PC 不卡、板端卡」的假象。本身不是性能收益。
CONFIG_LV_FREETYPE_CACHE_FT_GLYPH_CNT=1024
# FreeType 2.8.1 的 FT_Load_Glyph 轮廓路径栈占用大，32KB 会栈溢出（实测崩溃点 rsp 距栈顶仅 ~31KB）
CONFIG_LV_DRAW_THREAD_STACK_SIZE=262144

# --- 关闭 examples/demos（模板默认 y，且本移植未带其源码，必须显式关）---
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set

# SDL backend 在 SW draw 下需用 PARTIAL render mode（flush buffer → SDL texture）
CONFIG_LV_SDL_RENDER_MODE_PARTIAL=y

# --- 启用 snapshot API（PC 测试用：用于 SAFE_TEST_SHOT 模式截图）---
CONFIG_LV_USE_SNAPSHOT=y
