#include <unistd.h>
#include <pthread.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#include <lvgl/lvgl.h>

#if LV_BUILD_DEMOS
    #include <lv_demos.h>
#endif /*LV_BUILD_DEMOS*/

#if LV_BUILD_EXAMPLES
    #include <lv_examples.h>
#endif /*LV_BUILD_EXAMPLES*/

#ifdef CONFIG_LV_USE_DEMO_TRUCK
    #include <lv_demo_truck.h>
#endif /*CONFIG_LV_USE_DEMO_TRUCK*/

#include "lib/driver_backends.h"
#include "lib/simulator_util.h"
#include "lib/simulator_settings.h"

#include "ui/ui.h"
#include "hal/actuator.h"

/* Internal functions */
static void configure_simulator(int argc, char ** argv);
static void print_lvgl_version(void);
static void print_usage(void);

/* contains the name of the selected backend if user
 * has specified one on the command line */
static char * selected_backend;

/* Global simulator settings, defined in lv_linux_backend.c */
extern simulator_settings_t settings;


/**
 * @brief Print LVGL version
 */
static void print_lvgl_version(void)
{
    fprintf(stdout, "%d.%d.%d-%s\n",
            LVGL_VERSION_MAJOR,
            LVGL_VERSION_MINOR,
            LVGL_VERSION_PATCH,
            LVGL_VERSION_INFO);
}

/**
 * @brief Print usage information
 */
static void print_usage(void)
{
    fprintf(stdout,
            "\nlvglsim [-V] [-B] [-f] [-m] [-b backend_name] [-W window_width] [-H window_height] [-R rotation]\n\n");
    fprintf(stdout, "-V print LVGL version\n");
    fprintf(stdout, "-B list supported backends\n");
    fprintf(stdout, "-f fullscreen\n");
    fprintf(stdout, "-m maximize\n");
}

/**
 * @brief Configure simulator
 * @description process arguments received by the program to select
 * appropriate options
 * @param argc the count of arguments in argv
 * @param argv The arguments
 */
static void configure_simulator(int argc, char ** argv)
{
    int opt = 0;

    selected_backend = NULL;
    driver_backends_register();

    const char * env_w = getenv("LV_SIM_WINDOW_WIDTH");
    const char * env_h = getenv("LV_SIM_WINDOW_HEIGHT");
    /* Default values */
    settings.window_width = atoi(env_w ? env_w : "800");
    settings.window_height = atoi(env_h ? env_h : "480");

    /* Parse the command-line options. */
    while((opt = getopt(argc, argv, "b:fmW:H:R:BVh")) != -1) {
        switch(opt) {
            case 'h':
                print_usage();
                exit(EXIT_SUCCESS);
                break;
            case 'V':
                print_lvgl_version();
                exit(EXIT_SUCCESS);
                break;
            case 'B':
                driver_backends_print_supported();
                exit(EXIT_SUCCESS);
                break;
            case 'b':
                if(driver_backends_is_supported(optarg) == 0) {
                    die("error no such backend: %s\n", optarg);
                }
                selected_backend = strdup(optarg);
                break;
            case 'f':
                settings.fullscreen = true;
                break;
            case 'm':
                settings.maximize = true;
                break;
            case 'W':
                settings.window_width = atoi(optarg);
                break;
            case 'H':
                settings.window_height = atoi(optarg);
                break;
            case 'R':
                switch(atoi(optarg)) {
                    case 0:
                        settings.rotation = LV_DISPLAY_ROTATION_0;
                        break;
                    case 90:
                        settings.rotation = LV_DISPLAY_ROTATION_90;
                        break;
                    case 180:
                        settings.rotation = LV_DISPLAY_ROTATION_180;
                        break;
                    case 270:
                        settings.rotation = LV_DISPLAY_ROTATION_270;
                        break;
                    default:
                        LV_LOG_WARN("Invalid rotation angle. Valid angles are {0, 90, 180, 270}");
                        break;
                }
                break;
            case ':':
                print_usage();
                die("Option -%c requires an argument.\n", optopt);
                break;
            case '?':
                print_usage();
                die("Unknown option -%c.\n", optopt);
        }
    }
}


int main(int argc, char ** argv)
{

    configure_simulator(argc, argv);

    /* Initialize LVGL. */
    lv_init();

    /* ============================================================
     *  显示后端初始化：Ubuntu(PC) vs 开发板 对照
     *  ----------------------------------------------------------
     *  编译进哪些后端由 defconfig 决定（pc.defconfig -> sdl.c；
     *  get_started.defconfig -> fbdev.c）。本文件用 #if 自动选择，
     *  无需手动改：PC 上 LV_USE_SDL 生效走 SDL 分支；板子上
     *  LV_USE_LINUX_FBDEV 生效走 FBDEV 分支（SDL 分支被编译剔除，
     *  等效“注释掉”）。上板只需切 defconfig，本文件不动。
     *  命令行 -b <name> 可强制指定后端，覆盖下面的默认选择。
     * ============================================================ */
    if(selected_backend != NULL) {
        /* 显式指定：./lvglsim -b SDL | -b FBDEV */
        if(driver_backends_init_backend(selected_backend) == -1) {
            die("Failed to initialize display backend: %s", selected_backend);
        }
    }
#if LV_USE_SDL //使用SDL：预处理器保留该分支，初始化SDL
    else if(driver_backends_init_backend("SDL") == -1) {
        die("Failed to initialize SDL display backend");
    }
#elif LV_USE_LINUX_FBDEV //使用开发板：保留frambuffer分支
    else if(driver_backends_init_backend("FBDEV") == -1) {
        /* --- 开发板：FBDEV 直接写 /dev/fb0（上板时自动生效）--- */
        die("Failed to initialize FBDEV display backend");
    }
#endif
    else if(driver_backends_init_backend(NULL) == -1) {
        /* 兜底：用默认注册后端 */
        die("Failed to initialize display backend");
    }
    if(settings.rotation) {
#if LV_USE_DRAW_NANOVG && LV_DRAW_TRANSFORM_USE_MATRIX
        lv_display_set_matrix_rotation(NULL, true);
#endif
        lv_display_set_rotation(NULL, settings.rotation);
    }

    /* Enable for EVDEV support（开发板上生效；PC 上 LV_USE_EVDEV 未定义，自动编译剔除） */
#if LV_USE_EVDEV //使用开发板：预处理保留evdev分支
    if(driver_backends_init_backend("EVDEV") == -1) {
        die("Failed to initialize evdev");
    }
#endif

    /* 启动智能安防保险柜业务应用（替代模板 demo）：
     * 1) 初始化开锁执行器（板子上当前为打印模拟，真实 GPIO 见移植记录 P2 项）
     * 2) 创建整套 UI 外壳（顶栏 + 左导航 + 6 个页面） */
    actuator_init();
    app_start();

    while(1) {
        uint32_t ms = lv_timer_handler();
        if(ms == LV_NO_TIMER_READY) {
            ms = LV_DEF_REFR_PERIOD;
        }
        usleep(ms * 1000);
    }

    return 0;
}
