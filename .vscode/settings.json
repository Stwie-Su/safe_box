{
  // 强制使用 VM 上编译安装的高版本 cmake（系统 /usr/bin/cmake 也是 3.22.1，二者一致；保留以防系统被降级）
  "cmake.cmakePath": "/home/book/tools/cmake-3.22.1-linux-x86_64/bin/cmake",
  // 不再硬编码 Buildroot 的 python3：该解释器依赖 LD_LIBRARY_PATH 才能加载 libpython3.8，
  // 而 CMake 的 FindPython3 以“干净环境”启动解释器会报 Cannot run the interpreter。
  // 本机为 Ubuntu 22.04，系统 python3 是 3.10（>=3.7），直接用它即可，无需额外变量。
  "cmake.generator": "Unix Makefiles",
  // 默认走 PC(SDL) 配置；上板时把 buildDirectory 改为 build_board，并在 configureArgs 增加：
  //   "-DLV_PORT_DEFCONFIG=configs/get_started.defconfig",
  //   "-DCMAKE_TOOLCHAIN_FILE=cmake/user_cross_compile_setup.cmake"
  // 注意：板子工具链(Buildroot)的 sysroot 当前不完整(缺 crt1.o/libc)，板子构建需在 SDK 侧修复后才有
  "cmake.buildDirectory": "${workspaceFolder}/build_pc",
  "cmake.configureOnOpen": true,
  "cmake.statusBarVisibility": "visible"
}
